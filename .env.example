# Copy to .env.local and fill in what you have. Every key is optional:
# without it, that part of the app falls back to estimates.

# AI itineraries and "edit by chat" — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Live flight fares (Aviasales data) — free affiliate account at https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=
# Optional: your Travelpayouts marker, so bookings through the app earn commission
TRAVELPAYOUTS_MARKER=

# Live, bookable hotel rates — free sandbox key at https://www.liteapi.travel
LITEAPI_KEY=

# --- AI cost controls (see docs/ECONOMICS.md) ---
# Which Claude models write itineraries. Most trips get the standard model (default claude-haiku-5-5);
# luxury, Jain and vegan trips get the premium model (default claude-opus-5-5).
AI_STANDARD_MODEL=
AI_PREMIUM_MODEL=
# How much of the daily budget can go on the premium model, in USD (default 1). After that,
# those trips get the standard model until the next day.
AI_PREMIUM_DAILY_BUDGET_USD=
# Free AI itineraries and edits per browser per day (defaults: 3 and 10)
AI_PLANS_PER_VISITOR=
AI_EDITS_PER_VISITOR=
# Backstop per network (IP address) per day, for people who clear cookies (defaults: 30 and 100).
# Keep these well above the per-browser limits: a college hostel or a mobile carrier can put many people on one IP.
AI_PLANS_PER_NETWORK=
AI_EDITS_PER_NETWORK=
# Destination board requests per minute, per browser and per network (defaults: 30 and 300)
BOARD_PER_MINUTE_BROWSER=
BOARD_PER_MINUTE_NETWORK=
# Total AI spend allowed per day across all visitors, in US dollars (default: 2)
AI_DAILY_BUDGET_USD=

# Redis for the counters, cache, saved trips and group check-in: free Upstash database (Vercel → Storage → Upstash).
# Saved trips and group check-in stay hidden until this is set. Redeploy after adding it.
# Without it, limits only hold per server instance, which leaks on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Usage counts: pick any long random string, then open /api/stats?key=<it> to see the funnel
# (board → pass → plan → booking clicks and shares) and plan ratings for the last 14 days.
# Leave empty to keep the stats page off. Needs Redis.
STATS_KEY=
