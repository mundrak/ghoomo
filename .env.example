# Copy to .env.local and fill in what you have. Every key is optional:
# without it, that part of the app falls back to estimates.

# AI itineraries and "edit by chat" — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Live flight fares (Aviasales data) — free affiliate account at https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=
# Optional: your Travelpayouts marker, so bookings through the app earn commission
TRAVELPAYOUTS_MARKER=

# Live, bookable hotel rates — free sandbox key at https://www.liteapi.travel
LITEAPI_KEY=

# --- AI cost controls (see docs/ECONOMICS.md) ---
# Which Claude model writes itineraries: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5
CLAUDE_MODEL=
# Free AI itineraries and edits per visitor per day (defaults: 3 and 10)
AI_PLANS_PER_VISITOR=
AI_EDITS_PER_VISITOR=
# Total AI spend allowed per day across all visitors, in US dollars (default: 2)
AI_DAILY_BUDGET_USD=

# Redis for the counters and cache: free Upstash database (Vercel → Storage → Upstash).
# Without it, limits only hold per server instance, which leaks on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
