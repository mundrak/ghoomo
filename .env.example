# Copy to .env.local and fill in what you have. Every key is optional:
# without it, that part of the app falls back to estimates.

# AI itineraries and "edit by chat" — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Live flight fares (Aviasales data) — free affiliate account at https://www.travelpayouts.com
TRAVELPAYOUTS_TOKEN=
# Optional: your Travelpayouts marker, so bookings through the app earn commission
TRAVELPAYOUTS_MARKER=

# Live, bookable hotel rates — free sandbox key at https://www.liteapi.travel
LITEAPI_KEY=
